# ENTROPY lab configuration (copy to .env and adjust)

# Ganache / local Ethereum ledger
ENTROPY_GANACHE_URL=http://127.0.0.1:7545
ENTROPY_CONTRACT_ADDRESS=
ENTROPY_WALLET_ADDRESS=
# Fall back to the local SQLite ledger when Ganache is unreachable
ENTROPY_BLOCKCHAIN_FALLBACK=true

# Simulate destructive responses (quarantine/terminate) instead of running them.
# python lab.py always runs LIVE unless started with --dry-run.
ENTROPY_DRY_RUN=false

# Directories watched by the monitor (comma-separated, relative to the
# repository root). The victim estate below is ALWAYS watched, whatever
# this is set to, unless ENTROPY_WATCH_VICTIM=false.
ENTROPY_WATCH_FOLDERS=
# The victim estate (victim_server/user_files) is the defended asset:
# keep it watched even when ENTROPY_WATCH_FOLDERS is empty or lists
# unrelated folders. Set false only for a custom deployment.
ENTROPY_WATCH_VICTIM=true

# ── Detection pipeline supervision ────────────────────────────
# The pipeline (monitoring/pipeline_runner.py) is the process that
# detects encryption, kills the attacker PID, moves files to
# quarantine and restores clean backups. Starting the SOC dashboard
# (app.py) or the victim explorer also starts it — and keeps it alive —
# so the backend can never be silently missing during a demo.
# Set false to manage the pipeline entirely by hand.
ENTROPY_AUTOSTART_PIPELINE=true
# A heartbeat older than this means "the pipeline is not running".
ENTROPY_PIPELINE_STALE_SECONDS=8
# How often the supervisor re-checks, and the minimum delay between
# pipeline start attempts (it backs off if the pipeline keeps dying).
ENTROPY_PIPELINE_SUPERVISOR_INTERVAL=3
ENTROPY_PIPELINE_RESTART_COOLDOWN=10

# ── Federated threat-fingerprint exchange ─────────────────────
# Master switch for the shared "have we seen this fingerprint before?"
# registry. Confirmed threats are written; a fingerprint seen by >=
# ENTROPY_EXCHANGE_CONFIRM_THRESHOLD independent nodes auto-confirms.
ENTROPY_EXCHANGE=true
# This node's identity in the exchange (defaults to a stable hostname
# id). Set a distinct value per tenant/node.
ENTROPY_NODE_ID=
# Independent-node consensus required to treat a fingerprint as a known
# threat (minimum 2 — a single node can only corroborate, never confirm).
ENTROPY_EXCHANGE_CONFIRM_THRESHOLD=2
